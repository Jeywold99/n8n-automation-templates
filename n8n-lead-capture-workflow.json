    {
      "id": "node-sysprompt",
      "name": "AI System Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 300],
      "parameters": {
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "sp1",
              "name": "system_prompt",
              "type": "string",
              "value": "You are the lead-response assistant for COACH_NAME, a digital marketing coach who helps potential students WHAT_THE_COACH_TEACHES. You receive raw form submissions from potential students.\n\nFor every submission you must do three things:\n\n1. SUMMARIZE the lead in 2-3 sentences: who they are, what goal they stated, and their main pain point. Use only facts present in the submission - never invent details. If a field is missing or empty, say so explicitly.\n\n2. SCORE the lead as exactly one of: hot, warm, cold.\n- hot: clear goal PLUS an explicit urgency or readiness signal (mentions budget, asks about pricing, wants to start now or this month)\n- warm: genuine interest and a stated goal, but no urgency or readiness signal\n- cold: vague answers, no stated goal, spam-like content, or clearly outside the coach's offer\nGive a one-line score_reason that cites the specific signal from their answers.\n\n3. DRAFT a reply in the coach's voice:\n- Warm and direct. No fluff, no hype words, no emojis, no exclamation marks.\n- Short sentences. Address the lead by first name.\n- Reference their specific goal or pain point within the first two sentences so the reply is obviously personal.\n- 80-140 words total.\n- End with exactly one clear next step: invite them to book a call at BOOKING_LINK.\n- Sign off as COACH_FIRST_NAME.\n- Never promise results, prices, or guarantees. Never reveal that the reply was AI-drafted or that the lead was scored.\n\nOUTPUT FORMAT - respond with ONLY a single valid JSON object. No markdown fences, no commentary, nothing before or after the JSON:\n{\"summary\": \"...\", \"score\": \"hot|warm|cold\", \"score_reason\": \"...\", \"draft_reply\": \"...\"}\nUse \\n inside draft_reply for line breaks."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-claude",
      "name": "Claude: Analyze & Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 1500, temperature: 0.4, system: $json.system_prompt, messages: [ { role: 'user', content: 'New form submission from a potential student.\\n\\nName: ' + ($('Normalize Lead').first().json.name || 'not provided') + '\\nEmail: ' + ($('Normalize Lead').first().json.email || 'not provided') + '\\n\\nAll form answers (raw JSON):\\n' + $('Normalize Lead').first().json.raw_answers } ] }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "ANTHROPIC_CRED_ID",
          "name": "Anthropic account"
        }
      }
    },
    {
      "id": "node-parse",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300],
      "onError": "continueErrorOutput",
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst raw = (resp.content && resp.content[0] && resp.content[0].text) ? resp.content[0].text : '';\nif (!raw) {\n  throw new Error('Anthropic response contained no text content: ' + JSON.stringify(resp).slice(0, 300));\n}\nconst cleaned = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('AI returned invalid JSON: ' + raw.slice(0, 300));\n}\nconst { summary, score, score_reason, draft_reply } = parsed;\nif (!summary || !score || !draft_reply) {\n  throw new Error('AI JSON missing required fields. Got keys: ' + Object.keys(parsed).join(', '));\n}\nconst normScore = String(score).toLowerCase();\nif (!['hot', 'warm', 'cold'].includes(normScore)) {\n  throw new Error('AI returned invalid score: ' + score);\n}\nreturn [{ json: { summary, score: normScore, score_reason: score_reason || '', draft_reply } }];"
      }
    },
