              "value": "={{ $json.body.name || $json.body.first_name || $json.body.full_name || 'Unknown' }}"
            },
            {
              "id": "a4",
              "name": "email",
              "type": "string",
              "value": "={{ $json.body.email || $json.body.Email || '' }}"
            },
            {
              "id": "a5",
              "name": "raw_answers",
              "type": "string",
              "value": "={{ JSON.stringify($json.body, null, 2) }}"
            }
          ]
