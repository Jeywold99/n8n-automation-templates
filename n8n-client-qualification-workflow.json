      "id": "node-ask-reviewer",
      "name": "Gmail: Ask Reviewer (4h)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1400, 300],
      "onError": "continueErrorOutput",
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "sendTo": "REVIEWER_EMAIL@getshtdonehq.com",
        "subject": "=[{{ $('Parse AI Output').first().json.score.toUpperCase() }}] New application: {{ $('Normalize Lead').first().json.full_name }}{{ $('Normalize Lead').first().json.company ? ' — ' + $('Normalize Lead').first().json.company : '' }}",
        "message": "=New client application needs a reply.\n\nName: {{ $('Normalize Lead').first().json.full_name }}\nCompany: {{ $('Normalize Lead').first().json.company || '—' }}\nEmail: {{ $('Normalize Lead').first().json.email }}\nPhone: {{ $('Normalize Lead').first().json.phone || '—' }}\nBusiness / team / revenue: {{ $('Normalize Lead').first().json.business_type || '—' }} / {{ $('Normalize Lead').first().json.team_size || '—' }} / {{ $('Normalize Lead').first().json.monthly_revenue || '—' }}\n\nFit score: {{ $('Parse AI Output').first().json.score.toUpperCase() }} — {{ $('Parse AI Output').first().json.score_reason }}\n\nSummary:\n{{ $('Parse AI Output').first().json.summary }}\n\n===== DRAFT REPLY =====\n{{ $('Parse AI Output').first().json.draft_reply }}\n=======================\n\nClick below and choose:\n- approve: send the draft as-is\n- edit: paste your full edited version into edited_reply\n- reject: no reply is sent to this applicant\n\nNo response in 4 hours = one reminder. 8 hours after that, the applicant automatically gets a short holding reply so no lead goes cold.",
        "responseType": "customForm",
        "defineForm": "fields",
        "formFields": {
          "values": [
            {
              "fieldLabel": "decision",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "approve" },
                  { "option": "edit" },
                  { "option": "reject" }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "edited_reply",
              "fieldType": "textarea"
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 4,
              "resumeUnit": "hours"
            }
          }
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CRED_ID",
          "name": "GSD HQ Gmail"
        }
      }
    },
