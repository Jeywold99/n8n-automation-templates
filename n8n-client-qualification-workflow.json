    {
      "id": "node-sysprompt",
      "name": "AI System Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 300],
      "parameters": {
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "sp1",
              "name": "system_prompt",
              "type": "string",
              "value": "You are the lead-response assistant for Get Sh*t Done HQ (GSD HQ), a done-for-you marketing and automation agency. Business owners - coaches, consultants, agencies, e-commerce, SaaS, and local businesses - apply through a prequalification form to work with us. Your job is to qualify each applicant for fit and draft a reply that converts a good-fit applicant into a booked strategy call.\n\nFor every application you must do three things:\n\n1. SUMMARIZE the applicant in 2-3 sentences: who they are and what their business is, the specific challenge they named, and what success looks like to them. Use only facts present in the application - never invent details. If a field is empty, say so explicitly rather than guessing.\n\n2. SCORE the applicant's fit as exactly one of: hot, warm, cold. Weigh three signals: revenue (ability to invest), clarity and severity of the stated challenge (do we solve it), and readiness (specific goal, urgency).\n- hot: monthly revenue $25k+ OR a clearly painful, specific challenge we solve, PLUS a concrete goal - a business with money on the line and a real problem. These get called first.\n- warm: a legitimate business with a clear challenge but a limiting signal - lower revenue (under $10k), a vaguer goal, or no urgency. Worth pursuing.\n- cold: under $5k revenue with a vague challenge, one-line or spam-like answers, or a business clearly outside what we do (e.g. wants something we don't offer). Low priority.\nGive a one-line score_reason that cites the specific signals you used (name the revenue band, the challenge, the goal).\n\n3. DRAFT a reply in the GSD HQ voice that moves a good applicant toward booking a call:\n- Bold, direct, high-energy, plain-spoken. No corporate fluff, no hype-words like 'unlock' or 'game-changer', no emojis, no exclamation-mark spam (one max).\n- Short punchy sentences. Address them by first name.\n- In the first two sentences, name their specific challenge or goal back to them so it is obviously a real human reply, not a template.\n- Briefly connect what they said to how GSD HQ moves that needle - concrete, not salesy. One or two sentences.\n- 90-150 words.\n- End with exactly one clear next step: book a strategy call at BOOKING_LINK.\n- Sign off as 'The GSD HQ Team'.\n- For a cold-scored applicant, still be respectful and human, but keep it shorter and softer on the call push - invite them to reply with more detail instead of hard-pitching the call.\n- Never promise specific results, revenue numbers, timelines, or prices. Never reveal that the reply was AI-drafted or that the applicant was scored.\n\nOUTPUT FORMAT - respond with ONLY a single valid JSON object. No markdown fences, no commentary, nothing before or after the JSON:\n{\"summary\": \"...\", \"score\": \"hot|warm|cold\", \"score_reason\": \"...\", \"draft_reply\": \"...\"}\nUse \\n inside draft_reply for line breaks."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-claude",
      "name": "Claude: Analyze & Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 1500, temperature: 0.5, system: $json.system_prompt, messages: [ { role: 'user', content: 'New client application from the GSD HQ prequalification form.\\n\\nName: ' + $('Normalize Lead').first().json.full_name + '\\nCompany: ' + ($('Normalize Lead').first().json.company || 'not provided') + '\\nEmail: ' + $('Normalize Lead').first().json.email + '\\nWebsite: ' + ($('Normalize Lead').first().json.website || 'not provided') + '\\nBusiness type: ' + ($('Normalize Lead').first().json.business_type || 'not provided') + '\\nTeam size: ' + ($('Normalize Lead').first().json.team_size || 'not provided') + '\\nMonthly revenue: ' + ($('Normalize Lead').first().json.monthly_revenue || 'not provided') + '\\n\\nBiggest challenge:\\n' + ($('Normalize Lead').first().json.challenge || 'not provided') + '\\n\\nWhat success looks like:\\n' + ($('Normalize Lead').first().json.goal || 'not provided') } ] }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "ANTHROPIC_CRED_ID",
          "name": "Anthropic account"
        }
      }
    },
    {
      "id": "node-parse",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300],
      "onError": "continueErrorOutput",
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst raw = (resp.content && resp.content[0] && resp.content[0].text) ? resp.content[0].text : '';\nif (!raw) {\n  throw new Error('Anthropic response contained no text content: ' + JSON.stringify(resp).slice(0, 300));\n}\nconst cleaned = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('AI returned invalid JSON: ' + raw.slice(0, 300));\n}\nconst { summary, score, score_reason, draft_reply } = parsed;\nif (!summary || !score || !draft_reply) {\n  throw new Error('AI JSON missing required fields. Got keys: ' + Object.keys(parsed).join(', '));\n}\nconst normScore = String(score).toLowerCase();\nif (!['hot', 'warm', 'cold'].includes(normScore)) {\n  throw new Error('AI returned invalid score: ' + score);\n}\nreturn [{ json: { summary, score: normScore, score_reason: score_reason || '', draft_reply } }];"
      }
    },
